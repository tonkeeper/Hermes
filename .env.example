# ── Deployment ──
# Private key of the deployer (one key, used on every network). 0x-prefixed.
DEPLOYER_PRIVATE_KEY=0x...

# Optional: override the CREATE2 salt namespace. MUST be identical across chains
# for addresses to match. Defaults to "hermes.v1".
# CREATE2_SALT=Hermes.v1

# ── Verification ──
# One Etherscan v2 key covers all explorers (eth, bsc, arbitrum, base, ...).
ETHERSCAN_API_KEY=

# ── RPC overrides (optional; sensible public defaults are used otherwise) ──
# Mainnets
# ETH_RPC_URL=
# BSC_RPC_URL=
# ARBITRUM_RPC_URL=
# BASE_RPC_URL=
# Testnets
# SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=
# ARBITRUM_SEPOLIA_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# ── Relay mock server (server/) ──
# PORT=8787
# RELAY_PRIVATE_KEY=0x...            # relay wallet; defaults to hardhat account #1 (dev only)
# HERMES_MANAGER=0x...               # HermesV1 nonce manager (per-chain: HERMES_MANAGER_ETH, ...)
# HERMES_DELEGATE=0x...              # HermesDelegateV1 impl / EIP-712 salt (per-chain: HERMES_DELEGATE_ETH, ...)
# LOCAL_RPC_URL=http://127.0.0.1:8545
# LOCAL_TOKEN_ADDRESS=0x...          # fee token of the `local` chain

# ── Misc ──
# REPORT_GAS=false
# CMC_API=
