# ── Deployment ──
# Private key of the deployer (one key, used on every network). 0x-prefixed.
DEPLOYER_PRIVATE_KEY=0x...

# Optional: override the CREATE2 salt namespace. MUST be identical across chains
# for addresses to match. Defaults to "hermes.v1".
# CREATE2_SALT=Hermes.v1

# ── Verification ──
# One Etherscan v2 key covers all explorers (eth, bsc, arbitrum, base, ...).
ETHERSCAN_API_KEY=

# ── RPC overrides (optional; sensible public defaults are used otherwise) ──
# Mainnets
# ETH_RPC_URL=
# BSC_RPC_URL=
# ARBITRUM_RPC_URL=
# BASE_RPC_URL=
# Testnets
# SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=
# ARBITRUM_SEPOLIA_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# ── Misc ──
# REPORT_GAS=false
# CMC_API=
