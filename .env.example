# ── Deployment ──
# The deployer (one wallet, used on every network): either a 0x-prefixed private key
# or a BIP-39 mnemonic (its first account is used). Set exactly one.
DEPLOYER_PRIVATE_KEY=0x...
# DEPLOYER_MNEMONIC=word1 word2 ... word12

# Optional: override the CREATE2 salt namespace. MUST be identical across chains
# for addresses to match. Defaults to "Hermes.v1.0.0" (the production set).
# CREATE2_SALT=Hermes.v1.0.0

# ── Verification ──
# One Etherscan v2 key covers all explorers (eth, bsc, arbitrum, base, ...).
ETHERSCAN_API_KEY=

# ── RPC overrides (optional; sensible public defaults are used otherwise) ──
# Mainnets
# ETH_RPC_URL=
# BSC_RPC_URL=
# ARBITRUM_RPC_URL=
# BASE_RPC_URL=
# Testnets
# SEPOLIA_RPC_URL=
# BSC_TESTNET_RPC_URL=
# ARBITRUM_SEPOLIA_RPC_URL=
# BASE_SEPOLIA_RPC_URL=

# ── Misc ──
# REPORT_GAS=false
# CMC_API=
